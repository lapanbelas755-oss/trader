# Trader Machine V1 Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS

ENVIRONMENT=RESEARCH
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=trader_machine
DB_USER=trader_machine
DB_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql+psycopg://trader_machine:replace_with_secure_password@localhost:5433/trader_machine

# Symbol & Research Configuration
DEFAULT_SYMBOL=EURUSD
BASE_TIMEFRAME=M5

# ==============================================================================
# Windows MT5 Worker V3 Configuration (Read-Only Telemetry Node)
# ==============================================================================
WORKER_NODE_ID=win-mt5-worker-01
WORKER_NODE_NAME=Windows MT5 Worker V3
WORKER_ENVIRONMENT=DEMO
WORKER_ADAPTER_MODE=MOCK
# WORKER_HMAC_SECRET must be at least 16 characters. Generate via: python -c "import secrets; print(secrets.token_hex(32))"
WORKER_HMAC_SECRET=replace_with_32_byte_random_hmac_secret_key!
WORKER_BIND_HOST=127.0.0.1
WORKER_BIND_PORT=8080
WORKER_ALLOWED_SYMBOLS=EURUSD
# WORKER_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# WORKER_MT5_SERVER=Exness-Demo
# WORKER_MT5_LOGIN=12345678
WORKER_MT5_TIMEOUT_MS=5000
WORKER_REPLAY_WINDOW_SECONDS=30.0
WORKER_MAX_FUTURE_SKEW_SECONDS=5.0
WORKER_IDEMPOTENCY_TTL_SECONDS=60.0
WORKER_LOG_LEVEL=INFO
