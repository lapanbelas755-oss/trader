# Trader Machine V1 Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS

ENVIRONMENT=RESEARCH
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=trader_machine
DB_USER=trader_machine
DB_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql+psycopg://trader_machine:replace_with_secure_password@localhost:5433/trader_machine

# Symbol & Research Configuration
DEFAULT_SYMBOL=EURUSD
BASE_TIMEFRAME=M5

